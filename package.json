{
  "name": "starship-flow-control",
  "version": "1.1.0",
  "private": true,
  "description": "Synthetic, deterministic multi-level BOM constraint radar.",
  "scripts": {
    "lint": "eslint web/*.js tests/*.test.mjs eslint.config.mjs",
    "test:python": "python3 -m unittest discover -s tests -v",
    "test:web": "node --test tests/*.test.mjs",
    "verify:assets": "python3 scripts/verify_assets.py",
    "gate": "npm run lint && npm run test:python && npm run test:web && npm run verify:assets"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tarang-tj/starship-flow-control.git"
  },
  "license": "MIT",
  "devDependencies": {
    "eslint": "^9.39.5"
  }
}
